# Copy to .env and change values before sharing with a real client.
# docker compose automatically loads .env from this folder.

FINTRACK_IMAGE=hridoy335/fintrack:latest
API_PORT=5027
POSTGRES_PORT=5432

POSTGRES_DB=fintrackcore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeThisPassword

JWT_KEY=ChangeThisToALongSecretKeyAtLeast32Chars
JWT_ISSUER=FinTrackCore
JWT_AUDIENCE=FinTrackCore

ASPNETCORE_ENVIRONMENT=Production
SWAGGER_ENABLED=true

CORS_ORIGIN_0=http://localhost:4200
CORS_ORIGIN_1=http://127.0.0.1:4200
